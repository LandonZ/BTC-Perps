# Regeneratable market data and local caches
data/**/*.csv
data/**/*.tmp
!data/**/*_funding*.csv
data/binance/maker/**/archives/
__pycache__/

# Local builds; retain only the latest self-contained report
Primary-Market-Model/build/
Primary-Market-Model/results/*
!Primary-Market-Model/results/result.html
!Primary-Market-Model/results/result.png
!Primary-Market-Model/results/trials.json
!Primary-Market-Model/results/trials.png

# Tardis.dev raw downloads (re-downloadable; several GB per day)
data/binance/tardis/**/raw/
